/dts-v1/;

/ {
    description = "Signed FIT image for qemuarm Secure Boot";
    #address-cells = <1>;

    images {
        kernel-1 {
            description = "Linux kernel signed";
            data = /incbin/("./zImage");
            type = "kernel";
            arch = "arm";
            os = "linux";
            compression = "none";
            load = <0x40400000>;
            entry = <0x40400000>;
            hash-1 {
                algo = "sha256";
            };
        };
    };

    configurations {
        default = "conf-1";
        conf-1 {
            description = "Boot signed kernel";
            kernel = "kernel-1";
            signature-1 {
                algo = "sha256,rsa2048";
                key-name-hint = "fit-private";
                sign-images = "kernel";
            };
        };
    };
};
