#!/bin/sh
### BEGIN INIT INFO
# Provides:          ota-agent
# Required-Start:    $network swupdate
# Required-Stop:     $network
# Default-Start:     5
# Default-Stop:      0 1 6
# Short-Description: OTA Update Agent
### END INIT INFO

case "$1" in
    start)
        echo "Starting OTA Agent ..."
        start-stop-daemon -S -b -x /usr/bin/ota-agent
        ;;
    stop)
        echo "Stopping OTA Agent ..."
        start-stop-daemon -K -x /usr/bin/ota-agent
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac
